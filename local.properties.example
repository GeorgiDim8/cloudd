# Copy this file to "local.properties" (which is git-ignored) and fill in
# your own values. local.properties is read by app/build.gradle.kts.

# Android Studio writes sdk.dir into local.properties automatically - don't
# copy a placeholder path here, an invalid sdk.dir breaks Gradle sync.
# sdk.dir=C\:\\Users\\YOU\\AppData\\Local\\Android\\Sdk

# API key for a Google Cloud project that has the "Places API (New)"
# enabled. Used only for the Nearby Search HTTP call that finds the
# closest bus/train stop - it is compiled into BuildConfig.PLACES_API_KEY.
# See README.md for setup instructions.
MAPS_API_KEY=YOUR_API_KEY_HERE
